{
  "name": "tres-leches-demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run audit:i18n && npm run audit:customer-copy && vite build && node scripts/prerender-brand.mjs && node scripts/prepare-sites-build.mjs && node scripts/build-server.mjs",
    "preview": "vite preview",
    "start": "node dist/node/server.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/commerce/*.test.ts",
    "test:e2e": "playwright test",
    "audit": "npm audit --audit-level=moderate",
    "scan:secrets": "node scripts/secret-scan.mjs",
    "catalog": "tsx scripts/catalog-import.ts",
    "paymennt:register": "tsx scripts/register-paymennt-webhook.ts",
    "test:e2e:build": "E2E_BUILD=true playwright test",
    "audit:i18n": "node scripts/audit-i18n.mjs",
    "audit:customer-copy": "node scripts/audit-customer-copy.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "i18next": "^26.4.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-i18next": "^17.0.15",
    "vite": "6.4.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
