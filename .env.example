# Generate scrypt hash with scripts/operator-password.mjs. Never VITE_*.
OPERATOR_USERS_JSON=[]
# Future real adapter configuration; currently deliberately NOT consumed:
META_ACCESS_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=
META_PHONE_NUMBERS_JSON=[]
PAYMENNT_API_KEY=
