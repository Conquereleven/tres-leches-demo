# Explicit local sandbox; no credentials, no external messages/payments.
DEMO_MODE=true
INTEGRATION_MODE=false
API_PORT=3001
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:5173
DB_PATH=data/commerce.sqlite
SAFE_LOGS=true
# Required for NODE_ENV=production (24+ random characters).
WEBHOOK_SECRET=
# scrypt users via scripts/operator-password.mjs; roles admin/manager/operator.
# Legacy agent role remains compatible with previous sandbox fixtures.
OPERATOR_USERS_JSON=[]
# Integration: DEMO_MODE=false, INTEGRATION_MODE=true, HTTPS APP_ORIGIN,
# an absolute NEW DB_PATH on a persistent volume, and configured users.
META_ACCESS_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=
# Exactly 3 entries; IDs are wa1/wa2/wa3; real phone, phoneNumberId and wabaId.
META_NUMBERS_JSON=[]
PAYMENNT_API_KEY=
PAYMENNT_API_SECRET=
PAYMENNT_ENVIRONMENT=test
# Live charging is disabled pending pilot review. No arbitrary provider base URL.
# Paymennt webhook signature contract remains blocked; no invented signing config.
MAPBOX_ACCESS_TOKEN=
MAPBOX_PERMANENT_ENABLED=false
# Confirm permanent geocoding entitlement before setting true.
# Optional approved template with exactly two body parameters: AED amount, full URL.
# {"name":"YOUR_APPROVED_NAME","language":"en"}; leave blank until verified.
META_PAYMENT_TEMPLATE_JSON=
