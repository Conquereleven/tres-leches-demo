# TL-18 ENVIRONMENT CONTRACT — documentation placeholders only; no default credentials.
# Node reads process environment. Use your secret manager or node --env-file=YOUR_PRIVATE_FILE.
# See docs/tl18-staging.md for the exact matrix and required settings.
APP_ENV=development
NODE_ENV=development
DEMO_MODE=true
INTEGRATION_MODE=false
API_PORT=3001
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:5173
# Development/test use separate paths by default. Staging MUST set a NEW absolute path.
DB_PATH=
PERSISTENT_VOLUME_CONFIRMED=false
# Staging requires HTTPS origin (no path/query/userinfo), SESSION_SECURE=true,
# TTL 300..28800 seconds and real configured users with admin/manager/operator roles.
SESSION_SECURE=true
SESSION_TTL_SECONDS=1800
OPERATOR_USERS_JSON=[]
# Generate each hash: node scripts/operator-password.mjs USER_ID ROLE < secure-password-stdin
# Use unique passwords; no test fixture credentials. Nothing here is VITE_*.
WEBHOOK_SECRET=
SAFE_LOGS=true
# Staging: APP_ENV=staging NODE_ENV=production DEMO_MODE=false INTEGRATION_MODE=false
# PROVIDER_MODE must be explicit. offline = no provider access/no fake success;
# test = all provider settings below required and validated; Paymennt TEST only.
PROVIDER_MODE=offline
PAYMENNT_ENVIRONMENT=test
META_OUTBOUND_ENABLED=false
# TL-18 disables external WhatsApp at runtime even with configured Meta credentials.
META_ACCESS_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=
# Exactly three aliases with real TEST account configuration:
# [{"id":"wa1","label":"WA1","phone":"+...","phoneNumberId":"...","wabaId":"..."}, ...wa2, ...wa3]
META_NUMBERS_JSON=[]
# Optional approved two-body-parameter payment template: amount AED then full URL.
META_PAYMENT_TEMPLATE_JSON=
PAYMENNT_API_KEY=
PAYMENNT_API_SECRET=
# No configurable base URL. Adapter allows only https://api.test.paymennt.com/mer/v2.0.
# Paymennt notification verification remains unimplemented; webhook stays 503.
MAPBOX_ACCESS_TOKEN=
MAPBOX_PERMANENT_ENABLED=false
# Set true only with confirmed permanent-geocoding entitlement in PROVIDER_MODE=test.
# Staging backups required: separate absolute private directory, interval 15..1440 minutes,
# retain 2..168 snapshots. Initial online backup/integrity check must pass before listening.
BACKUP_DIR=
BACKUP_INTERVAL_MINUTES=60
BACKUP_RETENTION_COUNT=24
# Staging initial seed: empty or uat. Applied once to NEW staging-profile database.
# uat creates 3 TEST conversations/orders and 10 BLOCKED UAT records; never payments/jobs.
STAGING_SEED=uat
# APP_ENV=production is unconditionally blocked in this release. No approval env bypass.
