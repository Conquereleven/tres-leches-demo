# TL-25 ENVIRONMENT CONTRACT — documentation placeholders only; no default credentials.
# Node reads process environment. Use your secret manager or node --env-file=YOUR_PRIVATE_FILE.
# See docs/today-activation-runbook.md for the exact matrix and required settings.
APP_ENV=development
NODE_ENV=development
DEMO_MODE=false
INTEGRATION_MODE=false
API_PORT=3001
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:5173
# Development/test use separate paths by default. Staging MUST set a NEW absolute path.
DB_PATH=
PERSISTENT_VOLUME_CONFIRMED=false
# Staging requires HTTPS origin (no path/query/userinfo), SESSION_SECURE=true,
# TTL 300..28800 seconds and real configured users with admin/manager/operator roles.
SESSION_SECURE=true
SESSION_TTL_SECONDS=1800
OPERATOR_USERS_JSON=[]
# Generate each hash: node scripts/operator-password.mjs USER_ID ROLE < secure-password-stdin
# Use unique passwords; no test fixture credentials. Nothing here is VITE_*.
WEBHOOK_SECRET=
SAFE_LOGS=true
# Staging: APP_ENV=staging NODE_ENV=production DEMO_MODE=false INTEGRATION_MODE=false
# PROVIDER_MODE must be explicit. offline = no provider access/no fake success;
# test = independently activates configured provider groups; Paymennt TEST only.
PROVIDER_MODE=offline
PAYMENNT_ENVIRONMENT=test
META_OUTBOUND_ENABLED=false
# Inbound may be activated with one real origin while outbound remains false.
META_ACCESS_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=
# One to three aliases with real account configuration. Never add placeholder numbers.
# [{"id":"wa1","label":"WA1","phone":"+...","phoneNumberId":"...","wabaId":"..."}]
META_NUMBERS_JSON=[]
# Optional approved two-body-parameter payment template: amount AED then full URL.
META_PAYMENT_TEMPLATE_JSON=
PAYMENNT_API_KEY=
PAYMENNT_API_SECRET=
# Fixed API hosts: TEST api.test.paymennt.com; LIVE api.paymennt.com.
# Production LIVE requires PROVIDER_MODE=live, PAYMENNT_ENVIRONMENT=live and canonical APP_ORIGIN.
# Register the LIVE webhook and validate its private file BEFORE setting PAYMENNT_WEBHOOK_SECRET_FILE.
# Absolute private 0600 file created by registration tooling; never store under public/dist/repo.
PAYMENNT_WEBHOOK_SECRET_FILE=
MAPBOX_ACCESS_TOKEN=
MAPBOX_PERMANENT_ENABLED=false
# Set true only with confirmed permanent-geocoding entitlement in PROVIDER_MODE=test.
# Staging backups required: separate absolute private directory, interval 15..1440 minutes,
# retain 2..168 snapshots. Initial online backup/integrity check must pass before listening.
BACKUP_DIR=
BACKUP_INTERVAL_MINUTES=60
BACKUP_RETENTION_COUNT=24
# Staging initializes only approved zone configuration and empty operations.
# Fixtures are available only through tests/fixtures/server.ts.
STAGING_SEED=empty
# Production offline release: APP_ENV=production, PROVIDER_MODE=offline, AI_ENABLED=false.
# Require AI_AGENT_DEFAULT_MODE=copilot and AI_AUTONOMOUS_ALLOWED=false.
# Omit STAGING_SEED entirely in production; use a NEW production database.
# No provider credentials are needed or copied. Live activation remains blocked.
# BUILD_SOURCE_SHA is supplied at build time by the release process (full Git SHA).

# Server only. Demo data is forbidden in release runtime.
ALLOW_DEMO_DATA=false

# TL-26 AI: server-only opt-in. No key/model means NOT_CONFIGURED, never a mock.
AI_ENABLED=false
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=
AI_AGENT_DEFAULT_MODE=copilot
AI_AUTONOMOUS_ALLOWED=false
AI_TIMEOUT_MS=10000
AI_MAX_TURNS_PER_INBOUND=3
AI_MAX_TOOL_CALLS=6
AI_RATE_PER_MINUTE=6
# Keep copilot for the pilot. Payment and commercial actions always need approval.
# See docs/ai-agents/activation-runbook.md before enabling inference.

# Browser-safe public key for embedded TEST card frames (never use API credentials here).
PAYMENNT_PUBLIC_KEY=

# Master sprint: privately reviewed complete addresses + approved coordinates/polygons.
# Empty: website delivery fails closed; pickup remains available. No paid geocoder enabled.
# Registry autocomplete exposes only reviewed public locations marked searchable=true.
WEBSITE_ADDRESS_PROVIDER=registry
DELIVERY_VERIFIED_ADDRESSES_FILE=
# Optional private reviewed coverage override; empty uses the bundled final approved 3L boundary.
# Trustworthy address coordinates plus structured community/cluster evidence are required.
# Tariff polygons are optional legacy fallback when reviewed community evidence is absent.
DELIVERY_COVERAGE_FILE=
# Internal read-only MCP foundation, disabled until auth/client setup is reviewed.
MCP_ENABLED=false

# Manual delivery supported permanently; google requires verified address selection and fails closed.
DELIVERY_ADDRESS_MODE=legacy

# Internal paid-order WhatsApp alert for the 3L Manager (E.164). Private; never commit a real number.
# Internal delivery requires OPERATIONS_WHATSAPP_ENABLED and reviewed approved-template configuration.
WHATSAPP_MANAGER_PHONE=

# Customer order emails via Resend. All three are required to send; otherwise events are recorded and stay pending.
CUSTOMER_EMAIL_ENABLED=false
RESEND_API_KEY=
# Verified sender identity, e.g. "3L Pastelerías <orders@your-verified-domain>". Not assumed anywhere in code.
CUSTOMER_EMAIL_FROM=

# Sprint 1A shadow read only; never enabled in Production. No automatic bootstrap.
CATALOG_READ_API_ENABLED=false

# Product Hub V2. Editor and publication are separate; publication is refused in Production in code.
PRODUCT_HUB_ENABLED=false
PRODUCT_HUB_PUBLISH_ENABLED=false

# Storefront reads the published catalog at runtime. Production also needs the explicit
# activation value documented in docs/product-hub/storefront-dynamic-catalog.md.
STOREFRONT_DYNAMIC_CATALOG_ENABLED=false
STOREFRONT_DYNAMIC_CATALOG_PRODUCTION=

# Internal alerts, prospective only: complete configuration required before new payments.
OPERATIONS_EMAIL_ENABLED=false
# Comma-separated internal addresses. Never infer recipients from customer data.
OPERATIONS_EMAIL_TO=
# Optional subset of OPERATIONS_EMAIL_TO who receive compact HTML. Empty means original email for all.
OPERATIONS_EMAIL_COMPACT_TO=
# Optional dedicated sender; otherwise uses CUSTOMER_EMAIL_FROM.
OPERATIONS_EMAIL_FROM=

# Paid-order manager alert activation, independent of customer conversations.
# Keep customer META_OUTBOUND_ENABLED=false. A fixed UTC cutoff must be approved at activation; never use process startup.
OPERATIONS_WHATSAPP_ENABLED=false
OPERATIONS_WHATSAPP_TEMPLATE_POLICY_CONFIRMED=false
OPERATIONS_WHATSAPP_ACTIVATION_SINCE=
# Exact registered phone_number_id from META_NUMBERS_JSON; no first-number fallback.
OPERATIONS_WHATSAPP_PHONE_NUMBER_ID=
# Remains false until actual whatsapp_business_messaging permission is independently confirmed.
OPERATIONS_WHATSAPP_SEND_PERMISSION_CONFIRMED=false
# Exact Meta-approved name, en_US language and category, after separate content/category review.
OPERATIONS_WHATSAPP_TEMPLATE_JSON=

# One-time October 13 price-only release gate. Remove after verified apply.
PAN_PRICE_CORRECTION_20261013=false

# Personalized Pan de Muerto packs. Approval of published flavor eligibility and
# separate founder release authorization are required before enabling.
PERSONALIZED_PACKS_ENABLED=false
