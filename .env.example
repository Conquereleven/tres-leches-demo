# TL-25 ENVIRONMENT CONTRACT — documentation placeholders only; no default credentials.
# Node reads process environment. Use your secret manager or node --env-file=YOUR_PRIVATE_FILE.
# See docs/today-activation-runbook.md for the exact matrix and required settings.
APP_ENV=development
NODE_ENV=development
DEMO_MODE=false
INTEGRATION_MODE=false
API_PORT=3001
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:5173
# Development/test use separate paths by default. Staging MUST set a NEW absolute path.
DB_PATH=
PERSISTENT_VOLUME_CONFIRMED=false
# Staging requires HTTPS origin (no path/query/userinfo), SESSION_SECURE=true,
# TTL 300..28800 seconds and real configured users with admin/manager/operator roles.
SESSION_SECURE=true
SESSION_TTL_SECONDS=1800
OPERATOR_USERS_JSON=[]
# Generate each hash: node scripts/operator-password.mjs USER_ID ROLE < secure-password-stdin
# Use unique passwords; no test fixture credentials. Nothing here is VITE_*.
WEBHOOK_SECRET=
SAFE_LOGS=true
# Staging: APP_ENV=staging NODE_ENV=production DEMO_MODE=false INTEGRATION_MODE=false
# PROVIDER_MODE must be explicit. offline = no provider access/no fake success;
# test = independently activates configured provider groups; Paymennt TEST only.
PROVIDER_MODE=offline
PAYMENNT_ENVIRONMENT=test
META_OUTBOUND_ENABLED=false
# Inbound may be activated with one real origin while outbound remains false.
META_ACCESS_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=
# One to three aliases with real account configuration. Never add placeholder numbers.
# [{"id":"wa1","label":"WA1","phone":"+...","phoneNumberId":"...","wabaId":"..."}]
META_NUMBERS_JSON=[]
# Optional approved two-body-parameter payment template: amount AED then full URL.
META_PAYMENT_TEMPLATE_JSON=
PAYMENNT_API_KEY=
PAYMENNT_API_SECRET=
# No configurable base URL. Adapter allows only https://api.test.paymennt.com/mer/v2.0.
# Absolute private 0600 file created by registration tooling; never store under public/dist/repo.
PAYMENNT_WEBHOOK_SECRET_FILE=
MAPBOX_ACCESS_TOKEN=
MAPBOX_PERMANENT_ENABLED=false
# Set true only with confirmed permanent-geocoding entitlement in PROVIDER_MODE=test.
# Staging backups required: separate absolute private directory, interval 15..1440 minutes,
# retain 2..168 snapshots. Initial online backup/integrity check must pass before listening.
BACKUP_DIR=
BACKUP_INTERVAL_MINUTES=60
BACKUP_RETENTION_COUNT=24
# Staging initializes only approved zone configuration and empty operations.
# Fixtures are available only through tests/fixtures/server.ts.
STAGING_SEED=empty
# Production offline release: APP_ENV=production, PROVIDER_MODE=offline, AI_ENABLED=false.
# Require AI_AGENT_DEFAULT_MODE=copilot and AI_AUTONOMOUS_ALLOWED=false.
# Omit STAGING_SEED entirely in production; use a NEW production database.
# No provider credentials are needed or copied. Live activation remains blocked.
# BUILD_SOURCE_SHA is supplied at build time by the release process (full Git SHA).

# Server only. Demo data is forbidden in release runtime.
ALLOW_DEMO_DATA=false

# TL-26 AI: server-only opt-in. No key/model means NOT_CONFIGURED, never a mock.
AI_ENABLED=false
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=
AI_AGENT_DEFAULT_MODE=copilot
AI_AUTONOMOUS_ALLOWED=false
AI_TIMEOUT_MS=10000
AI_MAX_TURNS_PER_INBOUND=3
AI_MAX_TOOL_CALLS=6
AI_RATE_PER_MINUTE=6
# Keep copilot for the pilot. Payment and commercial actions always need approval.
# See docs/ai-agents/activation-runbook.md before enabling inference.
