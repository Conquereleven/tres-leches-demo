# Local development: no credentials needed; all providers are explicit simulations.
DEMO_MODE=true
API_PORT=3001
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:5173
DB_PATH=data/commerce.sqlite
# Required for NODE_ENV=production sandbox; >=24 random characters.
WEBHOOK_SECRET=
